DISCORD_TOKEN=your-discord-bot-token
# OpenAI-compatible Chat Completions endpoint (include /v1 if the provider uses it).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-model-id
# Optional Chat Completions reasoning_effort. Unset omits the field.
# Set to none to skip thinking tokens on hybrid reasoning models.
# OPENAI_REASONING_EFFORT=none
DB_PATH=./translator.db
HTTP_ADDR=:8080
PUBLIC_BASE_URL=https://your-public-domain.example
# Per-guild token limit per minute (default: 100000).
TRANSLATION_RATE_LIMIT_TOKENS_PER_MIN=100000
AVATAR_RATE_LIMIT_REQUESTS_PER_MIN=120
# MESSAGE_LINK_RETENTION_DAYS=60
# GUILD_DATA_RETENTION_DAYS=30
# Debug only: append every translation round trip (synthesized prompts,
# cache hit, token usage, provider cost, raw request/response) as JSON Lines.
# Unset disables the log.
# TRANSLATION_DEBUG_LOG_PATH=./translation-debug.log
