<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet">
  <meta name="description" content="Replace this placeholder with your instance privacy policy.">
  <title>プライバシーポリシー | AutoTranslator</title>
  <link rel="stylesheet" href="/legal-assets/styles.css">
</head>
<body>
  <a class="skip-link" href="#main-content">本文へ移動</a>
  <header class="site-header">
    <div class="header-inner">
      <span class="brand">AutoTranslator</span>
      <nav class="site-nav" aria-label="主要ナビゲーション">
        <ul>
          <li><a href="/privacy" aria-current="page">プライバシーポリシー</a></li>
          <li><a href="/terms">利用規約</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main-content">
    <article class="document">
      <header class="document-header">
        <p class="eyebrow">Privacy policy</p>
        <h1>AutoTranslator プライバシーポリシー</h1>
        <p class="effective-date">EXAMPLE_PRIVACY_POLICY</p>
        <p class="document-intro">This file is a placeholder. Copy it to <code>privacy.html</code> and replace the body with the privacy policy for your hosted instance. The real <code>privacy.html</code> is gitignored and must not be committed.</p>
      </header>

      <section aria-labelledby="privacy-1">
        <h2 id="privacy-1">1. Placeholder</h2>
        <p>Describe what personal data your instance collects and how it is processed.</p>
      </section>

      <section aria-labelledby="privacy-contact">
        <h2 id="privacy-contact">Contact</h2>
        <p class="document-cross-link">利用規約：<a href="/terms">/terms</a></p>
      </section>
    </article>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>AutoTranslator</p>
      <ul class="footer-nav" aria-label="フッターナビゲーション">
        <li><a href="/privacy" aria-current="page">プライバシー</a></li>
        <li><a href="/terms">利用規約</a></li>
      </ul>
    </div>
  </footer>
</body>
</html>
